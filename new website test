    function appRowsHTML(plan, deviceId, lang){
      const ar = lang === 'ar';
      const recLabel = ar ? 'موصى به' : 'Recommended';
      return `<div class="app-list">${plan.apps.map(app=>{
        const codeEl = deviceId === 'android' ? linkChip(app.code) : copyChip(app.code);
        const warns = ar ? app.warnAr : app.warnEn;
        const recBadge = app.rec ? `<span class="app-rec">${recLabel}</span>` : '';
        const warnsHtml = warns.length
          ? `<div class="app-warns">${warns.map(w=>`<div class="app-warn">&#9888;&#65038; ${w}</div>`).join('')}</div>`
          : '';
        return `<div class="app-row${app.rec ? ' is-rec' : ''}">
          <div class="app-row-head"><span class="app-name">${app.name}</span>${recBadge}</div>
          <div class="app-code-wrap">${codeEl}</div>
          ${warnsHtml}
        </div>`;
      }).join('')}</div>`;
    }

    function buildFlows(lang, plan){
      const ar = lang === 'ar';
      const isEgyptPlan = plan.id === 'xtv' || plan.id === 'marvel';

      const mf = ar
        ? `سيفتح الرابط صفحة MediaFire. اضغط على زر التحميل الأزرق الكبير — وليس زر «Download faster».`
        : `The link opens a MediaFire page. Tap the big blue Download button — not the "Download faster" button.`;
      const watchTut = ar ? 'شاهد الشرح' : 'Watch the tutorial';
      const watchVid = ar ? 'شاهد الشرح' : 'Watch the video';
      const lblAlt   = ar ? 'بديل' : 'Alternative';
      const lblTut   = ar ? 'شرح'  : 'Tutorial';

      const androidtv = {
        id:'androidtv', icon:ICONS.androidtv,
        name: ar ? 'أندرويد تي في' : 'Android TV',
        steps:[
          {html: ar ? `افتح Google Play على التلفاز وثبّت تطبيق <b>Downloader by AFTVNews</b>.` : `Open Google Play on your TV and install <b>Downloader by AFTVNews</b>.`},
          {html: (ar ? `افتح Downloader واكتب كود التطبيق:` : `Open Downloader and type your app code:`) + appRowsHTML(plan,'androidtv',lang)},
          {html: mf},
          {html: ar ? `ثبّت التطبيق، افتحه، وسجّل الدخول ببيانات اشتراكك.` : `Install the app, open it, and sign in with your subscription details.`},
        ],
        notes:[{type:'tip', label:lblAlt, html: ar
          ? `تفضّل <b>IPTV Smarters Pro</b>؟ اكتب ${copyChip(SMARTERS_CODE)} في Downloader — يعمل مع أي باقة. <a href="${SMARTERS_VIDEO}" target="_blank" rel="noopener noreferrer">${watchTut}</a>.`
          : `Prefer <b>IPTV Smarters Pro</b>? Enter ${copyChip(SMARTERS_CODE)} in Downloader — works on every plan. <a href="${SMARTERS_VIDEO}" target="_blank" rel="noopener noreferrer">${watchTut}</a>.`}],
      };

      const firestick = {
        id:'firestick', icon:ICONS.firestick,
        name: ar ? 'فايرستيك' : 'Firestick',
        steps:[
          {html: ar ? `افتح <b>Amazon Appstore</b> وثبّت <b>Downloader by AFTVNews</b>.` : `Open the <b>Amazon Appstore</b> and install <b>Downloader by AFTVNews</b>.`},
          {html: (ar ? `افتح Downloader واكتب كود التطبيق:` : `Open Downloader and type your app code:`) + appRowsHTML(plan,'firestick',lang)},
          {html: mf},
          {html: ar ? `ثبّت التطبيق، افتحه، وسجّل الدخول ببيانات اشتراكك.` : `Install the app, open it, and sign in with your subscription details.`},
        ],
        notes:[{type:'tip', label:lblAlt, html: ar
          ? `تفضّل <b>IPTV Smarters Pro</b>؟ اكتب ${copyChip(SMARTERS_CODE)} في Downloader — يعمل مع أي باقة. <a href="${SMARTERS_VIDEO}" target="_blank" rel="noopener noreferrer">${watchTut}</a>.`
          : `Prefer <b>IPTV Smarters Pro</b>? Enter ${copyChip(SMARTERS_CODE)} in Downloader — works on every plan. <a href="${SMARTERS_VIDEO}" target="_blank" rel="noopener noreferrer">${watchTut}</a>.`}],
      };

      const android = {
        id:'android', icon:ICONS.phone,
        name: ar ? 'موبايل وتابلت أندرويد' : 'Android Mobile & Tablet',
        steps:[
          {html: (ar ? `افتح متصفح هاتفك واختر رابط تطبيقك:` : `Open your phone's browser and go to your download link:`) + appRowsHTML(plan,'android',lang)},
          {html: mf},
          {html: ar ? `بعد تنزيل ملف APK، افتحه لتثبيته.` : `Once the APK downloads, open it to install.`},
          {html: ar ? `افتح التطبيق وسجّل الدخول بالبيانات التي أرسلناها لك.` : `Open the app and sign in with the details we sent you.`},
        ],
        notes:[{type:'tip', label:lblAlt, html: ar
          ? `يمكنك أيضًا تحميل <b>Smarters Pro</b> من ${linkChip(SMARTERS_CODE)}.`
          : `You can also grab the mobile <b>Smarters Pro</b> app from ${linkChip(SMARTERS_CODE)}.`}],
      };

      const ios = {
        id:'ios', icon:ICONS.apple,
        name: ar ? 'آيفون وماك وأبل تي في' : 'iPhone, Mac & Apple TV',
        steps:[
          {html: ar ? `افتح متجر تطبيقات أبل (App Store).` : `Open the <b>Apple App Store</b>.`},
          {html: ar ? `ابحث عن تطبيق <b>Smarters Player Lite</b> وثبّته.` : `Search for and install <b>Smarters Player Lite</b>.`},
          {html: ar ? `افتح التطبيق واختر <b>Xtream Codes API</b>.` : `Open the player and choose the <b>Xtream Codes API</b> login option.`},
          {html: ar ? `أدخل اسم المستخدم وكلمة المرور ورابط السيرفر المرسلة لك على واتساب.` : `Enter the username, password and host URL we sent you on WhatsApp.`},
        ],
        notes:[],
      };

      const smartNotes = isEgyptPlan
        ? [{type:'warn', label: ar ? 'تنبيه' : 'Heads up', html: ar
            ? `تطبيق IBO Player يتطلب رسوم تفعيل لمرة واحدة (حوالي <b>200 جنيه</b>) بعد تجربة مجانية 7 أيام.`
            : `IBO Player charges a one-time activation fee (approx. <b>200 EGP</b>) after its 7-day free trial.`}]
        : [{type:'tip', label: ar ? 'ملاحظة' : 'Note', html: ar
            ? `أول تفعيل IBO Player مجاني مع باقتك. كل تلفاز أو جهاز إضافي مقابل <b>4 دولار أمريكي</b>.`
            : `Your first IBO Player activation is free with your plan. Each extra TV or device is <b>$4 (USD)</b>.`}];

      const smarttv = {
        id:'smarttv', icon:ICONS.tv,
        name: ar ? 'شاشات سمارت (سامسونج و إل جي)' : 'Smart TV (Samsung & LG)',
        steps:[
          {html: ar ? `افتح متجر التطبيقات في التلفاز وابحث عن <b>IBO Player</b>.` : `Open your TV's built-in app store and search for <b>IBO Player</b>.`},
          {html: ar ? `ثبّت التطبيق ثم افتحه.` : `Install and open the app.`},
          {html: ar ? `ستظهر على الشاشة <b>Device ID</b> و <b>Device Key</b>. التقط صورة واضحة وأرسلها إلى Hossam TV على واتساب.` : `The screen shows a <b>Device ID</b> and <b>Device Key</b>. Take a clear photo and send it to Hossam TV on WhatsApp — we will load your playlist.`},
        ],
        notes: smartNotes,
      };

      const windows = {
        id:'windows', icon:ICONS.laptop,
        name: ar ? 'كمبيوتر ولابتوب ويندوز' : 'Windows PC & Laptop',
        steps:[
          {html: ar
            ? `حمّل <b>SFVIP Player</b> (ملف ZIP) من <a href="${SFVIP_ZIP}" target="_blank" rel="noopener noreferrer">MediaFire</a>.<span class="hint">اضغط على زر التحميل الأزرق الكبير — وليس زر «Download faster».</span>`
            : `Download the <b>SFVIP Player</b> package (ZIP) from <a href="${SFVIP_ZIP}" target="_blank" rel="noopener noreferrer">MediaFire</a>.<span class="hint">Tap the big blue Download button — not the "Download faster" button.</span>`},
          {html: ar ? `فك ضغط الملف وشغّل التطبيق.` : `Unzip the file and run the application inside.`},
          {html: ar ? `سجّل الدخول ببيانات اشتراكك لبدء المشاهدة.` : `Sign in with your subscription details to start streaming.`},
        ],
        notes:[{type:'tip', label:lblTut, html: ar
          ? `تحب تتابع الخطوات بالفيديو؟ <a href="${SFVIP_VIDEO}" target="_blank" rel="noopener noreferrer">${watchVid}</a>.`
          : `Want to follow along on screen? <a href="${SFVIP_VIDEO}" target="_blank" rel="noopener noreferrer">${watchVid}</a>.`}],
      };

      const roku = {
        id:'roku', icon:ICONS.roku, roku:true,
        name: ar ? 'روكو (Roku)' : 'Roku',
        message: ar
          ? `روكو؟ للأسف لا ندعمه — وبصراحة لسنا من أكبر محبيه.<br>اختر أي جهاز آخر وسنظبط لك كل شيء.`
          : `Roku? Afraid we don't support it — and between us, we're not its biggest fans.<br>Pick any other device and we'll get you sorted.`,
      };

      return [androidtv, firestick, android, ios, smarttv, windows, roku];
    }

    const sxRoot      = document.getElementById('sx');
    const plansGridEl = document.getElementById('plansGrid');
    const deviceBlock = document.getElementById('deviceBlock');
    const devicesEl   = document.getElementById('devices');
    const stepsBlock  = document.getElementById('stepsBlock');
    const crumbEl     = document.getElementById('crumb');
    const stepsEl     = document.getElementById('steps');
    const notesEl     = document.getElementById('notes');
    const rokuMsg     = document.getElementById('rokuMsg');
    const resetBtn    = document.getElementById('reset');
    const goldenEl    = document.getElementById('golden');
    const toastEl     = document.getElementById('toast');

    let activePlan  = null;
    let activeDevId = null;
    let toastTimer  = null;

    function reveal(el){
      el.hidden = false; el.classList.remove('show');
      requestAnimationFrame(()=>requestAnimationFrame(()=>el.classList.add('show')));
    }
    function applyStaticText(){
      const t = STR[curLang()];
      sxRoot.querySelectorAll('[data-t]').forEach(el=>{ el.textContent = t[el.dataset.t]; });
    }
    function renderDisclaimer(){
      const ar = curLang() === 'ar';
      const keyIcon = `<svg class="gr-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4"/><path d="M10.3 12.7 20 3M17 6l2.5 2.5M14.5 8.5 17 11"/></svg>`;
      goldenEl.innerHTML = ar
        ? `${keyIcon}<div class="gr-body"><p class="gr-title"><b>القاعدة الذهبية:</b> يمكنك المشاهدة على جهاز واحد فقط في نفس الوقت.</p><p class="gr-sub">ثبّت الاشتراك على أي عدد من الأجهزة، لكن لا يمكن التشغيل إلا على جهاز واحد في آنٍ واحد.</p></div>`
        : `${keyIcon}<div class="gr-body"><p class="gr-title"><b>Golden Rule:</b> you can stream on only one device at a time.</p><p class="gr-sub">Install on as many devices as you like — only one can play at once.</p></div>`;
    }
    function renderPlans(){
      const lang = curLang();
      plansGridEl.innerHTML = '';
      PLAN_DATA.forEach(plan=>{
        const btn = document.createElement('button');
        btn.className = 'plan-card'; btn.type = 'button'; btn.dataset.id = plan.id;
        btn.style.setProperty('--p-accent', plan.accent);
        btn.style.setProperty('--p-soft', plan.accentSoft);
        const on = activePlan && activePlan.id === plan.id;
        if(on) btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.setAttribute('aria-label', plan.name[lang]);
        btn.innerHTML = `
          <span class="plan-check">${ICONS.check}</span>
          <img class="plan-card-img" src="${plan.img}" alt="${plan.name.en}" width="66" height="66" loading="lazy" decoding="async">
          <span class="plan-card-name">${plan.name[lang]}</span>`;
        btn.addEventListener('click', ()=>selectPlan(plan));
        plansGridEl.appendChild(btn);
      });
    }
    function setPickedCard(key){
      document.querySelectorAll('#grid-plan .selection-card').forEach(c => c.classList.toggle('picked', c.dataset.key === key));
    }
    function selectPlan(plan){
      activePlan = plan;
      activeDevId = null;
      sxRoot.style.setProperty('--accent', plan.accent);
      sxRoot.style.setProperty('--accent-soft', plan.accentSoft);
      sxRoot.style.setProperty('--accent-soft-2', plan.accentSoft2);
      sxRoot.style.setProperty('--accent-700', plan.accent700);
      [...plansGridEl.children].forEach(c=>{
        const on = c.dataset.id === plan.id;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      stepsBlock.hidden = true; stepsBlock.classList.remove('show');
      resetBtn.hidden = true;
      renderDevices();
      if(deviceBlock.hidden) reveal(deviceBlock);
      else deviceBlock.classList.add('show');
      setTimeout(()=>deviceBlock.scrollIntoView({behavior:'smooth', block:'nearest'}), 160);
    }
    function renderDevices(){
      if(!activePlan) return;
      const flows = buildFlows(curLang(), activePlan);
      devicesEl.innerHTML = '';
      flows.forEach(dev=>{
        const btn = document.createElement('button');
        btn.className = 'device'; btn.type = 'button'; btn.dataset.id = dev.id;
        const on = dev.id === activeDevId;
        if(on) btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.setAttribute('aria-label', dev.name);
        btn.innerHTML = `<span class="device-icon">${dev.icon}</span><span class="device-name">${dev.name}</span>`;
        btn.addEventListener('click', ()=>selectDevice(dev.id));
        devicesEl.appendChild(btn);
      });
    }
    function selectDevice(devId){
      activeDevId = devId;
      [...devicesEl.children].forEach(c=>{
        const on = c.dataset.id === devId;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      resetBtn.hidden = false;
      renderSteps();
    }
    function renderSteps(){
      if(!activePlan || !activeDevId) return;
      const lang = curLang();
      const dev = buildFlows(lang, activePlan).find(d=>d.id===activeDevId);
      if(!dev) return;

      if(dev.roku){
        crumbEl.innerHTML=''; stepsEl.innerHTML=''; notesEl.innerHTML='';
        rokuMsg.hidden = false;
        rokuMsg.innerHTML = `<div class="roku-card"><span class="roku-emoji">🙂</span><p>${dev.message}</p></div>`;
        reveal(stepsBlock);
        setTimeout(()=>stepsBlock.scrollIntoView({behavior:'smooth', block:'nearest'}), 80);
        return;
      }
      rokuMsg.hidden = true; rokuMsg.innerHTML = '';
      crumbEl.innerHTML = STR[lang].settingUp(dev.name);
      stepsEl.innerHTML = dev.steps.map((s,i)=>`
        <li class="step">
          <span class="step-num">${i+1}</span>
          <span class="step-body"><div class="step-text">${s.html}</div></span>
        </li>`).join('');
      notesEl.innerHTML = (dev.notes||[]).map(n=>`
        <div class="note ${n.type==='warn'?'warn':'tip'}">
          <span class="label">${n.label}</span>
          <div>${n.html}</div>
        </div>`).join('');
      reveal(stepsBlock);
      setTimeout(()=>stepsBlock.scrollIntoView({behavior:'smooth', block:'nearest'}), 80);
    }

    function showToast(msg){
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(()=>toastEl.classList.remove('show'), 1400);
    }
    function copyText(text){
      (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
        .then(()=>showToast(STR[curLang()].copied))
        .catch(()=>{
          const ta = document.createElement('textarea');
          ta.value = text; ta.style.position='absolute'; ta.style.left='-9999px';
          document.body.appendChild(ta); ta.select();
          try{ document.execCommand('copy'); showToast(STR[curLang()].copied); }catch(e){}
          document.body.removeChild(ta);
        });
    }
    document.addEventListener('click', e=>{
      const b = e.target.closest('#sx [data-copy]');
      if(!b) return;
      e.preventDefault();
      copyText(b.getAttribute('data-copy'));
    });

    function resetAll(){
      activeDevId = null;
      [...devicesEl.children].forEach(c=>{ c.classList.remove('is-active'); c.setAttribute('aria-pressed','false'); });
      stepsBlock.hidden = true; stepsBlock.classList.remove('show');
      resetBtn.hidden = true;
      deviceBlock.scrollIntoView({behavior:'smooth', block:'nearest'});
    }
    resetBtn.addEventListener('click', resetAll);

    function sxRefresh(){
      applyStaticText();
      renderDisclaimer();
      renderPlans();
      if(activePlan){ renderDevices(); }
      if(activePlan && activeDevId){ renderSteps(); }
    }

    window.__sxRefresh = sxRefresh;
    window.pickAndScroll = function(key){
      const plan = PLAN_DATA.find(p=>p.id===key);
      if(!plan) return;
      setPickedCard(key);
      selectPlan(plan);
      document.getElementById('setup').scrollIntoView({ behavior:'smooth', block:'start' });
    };

    sxRefresh();
  })();
</script>

<script>
(function(){if(!window.chatbase||window.chatbase("getState")!=="initialized"){window.chatbase=(...arguments)=>{if(!window.chatbase.q){window.chatbase.q=[]}window.chatbase.q.push(arguments)};window.chatbase=new Proxy(window.chatbase,{get(target,prop){if(prop==="q"){return target.q}return(...args)=>target(prop,...args)}})}const onLoad=function(){const script=document.createElement("script");script.src="https://www.chatbase.co/embed.min.js";script.id="UR4AT8qVyiMZfTLECiywM";script.domain="www.chatbase.co";document.body.appendChild(script)};if(document.readyState==="complete"){onLoad()}else{window.addEventListener("load",onLoad)}})();
</script>

