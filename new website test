<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#07070c">
<meta name="description" content="Hossam TV Premium IPTV Services. Watch Sports, Movies, and Series in 4K/UHD.">
<title>Hossam TV — Premium IPTV Services</title>

<link rel="icon" type="image/png" href="logo.png">
<link rel="apple-touch-icon" href="logo.png">
<link rel="preconnect" href="https://hossamurai.github.io">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Great+Vibes&family=JetBrains+Mono:wght@500;700&family=Poppins:wght@400;500;600;700;800;900&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/@phosphor-icons/web"></script>

<style>
  :root {
    --bg: #07070c;
    --surface: rgba(255,255,255,0.04);
    --surface-2: rgba(255,255,255,0.07);
    --line: rgba(255,255,255,0.09);
    --line-strong: rgba(255,255,255,0.16);
    --ink: #f2f2f5;
    --muted: #9aa0ad;
    --faint: #6b7280;

    --gold: #e9b949;
    --gold-2: #ff7847;
    --gold-grad: linear-gradient(120deg, #f7dc8a, #e9a13b 55%, #ff7847);
    --gold-soft: rgba(233,185,73,0.12);
    --gold-border: rgba(233,185,73,0.35);

    --red: #ff5c73;
    --green: #3ddc97;
    --blue: #5b9bf5;
    --cyan: #38c8f2;

    --wa: #25D366;
    --shadow: 0 24px 60px rgba(0,0,0,0.5);
    --shadow-sm: 0 10px 30px rgba(0,0,0,0.35);
    --radius-card: 24px;
    --radius-pill: 999px;
  }

  .selection-card[data-theme="blue"]  { --tint: var(--blue);  --tint-soft: rgba(91,155,245,0.13); }
  .selection-card[data-theme="gold"]  { --tint: var(--gold);  --tint-soft: rgba(233,185,73,0.13); }
  .selection-card[data-theme="red"]   { --tint: var(--red);   --tint-soft: rgba(255,92,115,0.13); }
  .selection-card[data-theme="green"] { --tint: var(--green); --tint-soft: rgba(61,220,151,0.13); }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; }
  body { margin: 0; }
  ::selection { background: rgba(233,185,73,0.35); color: #fff; }
  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: #0a0a10; }
  ::-webkit-scrollbar-thumb { background: #26262f; border-radius: 8px; }
  ::-webkit-scrollbar-thumb:hover { background: #34343f; }
  img { border-radius: 22%; }

  body {
    font-family: 'Poppins', sans-serif;
    color: var(--ink);
    background:
      radial-gradient(1100px 500px at 85% -10%, rgba(139,92,246,0.10), transparent 60%),
      radial-gradient(900px 480px at -10% 30%, rgba(233,169,59,0.07), transparent 60%),
      var(--bg);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-text-size-adjust: 100%;
  }
  body.ltr { direction: ltr; text-align: left; }
  body.rtl { direction: rtl; text-align: right; font-family: 'Cairo', sans-serif; }
  body.ltr .view-ar { display: none !important; }
  body.rtl .view-en { display: none !important; }
  body.rtl h1, body.rtl h2, body.rtl h3, body.rtl .stat-num { font-family: 'Cairo', sans-serif; }

  .grad-text {
    background: var(--gold-grad);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }

  .container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  section[id] { scroll-margin-top: 96px; }

  /* ================= NAV ================= */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(7,7,12,0.75);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
    padding: 12px 22px;
    display: flex; align-items: center; gap: 14px;
  }
  .nav-brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); flex-shrink: 0; }
  .nav-logo { width: 34px; height: 34px; display: block; filter: drop-shadow(0 4px 12px rgba(233,169,59,0.35)); }
  .nav-brand-text { font-weight: 800; font-size: 1.05rem; letter-spacing: -0.01em; }
  .nav-brand-text em { font-style: normal; }
  .nav-links { display: flex; align-items: center; justify-content: center; gap: 4px; flex: 1 1 auto; }
  .nav-links a, nav button.navlink {
    text-decoration: none; color: var(--muted);
    font-weight: 600; font-size: 0.85rem;
    padding: 8px 14px; border-radius: var(--radius-pill);
    transition: all 0.2s ease; cursor: pointer;
    white-space: nowrap; border: none; background: transparent;
    font-family: inherit; line-height: 1;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .nav-links a:hover, nav button.navlink:hover { background: rgba(255,255,255,0.06); color: var(--ink); }
  .nav-links a.active { color: var(--gold); background: var(--gold-soft); box-shadow: inset 0 0 0 1px var(--gold-border); }
  .nav-highlight {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--wa); color: #04340f !important;
    font-weight: 700; font-size: 0.85rem; text-decoration: none;
    padding: 10px 18px; border-radius: var(--radius-pill);
    box-shadow: 0 8px 22px rgba(37,211,102,0.28);
    transition: filter .2s, transform .2s; flex-shrink: 0;
  }
  .nav-highlight:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .lang-btn { border: 1px solid var(--line-strong) !important; color: var(--ink) !important; background: rgba(255,255,255,0.03) !important; flex-shrink: 0; }

  /* ================= HERO ================= */
  header {
    position: relative; text-align: center;
    padding: 96px 20px 66px; overflow: hidden;
  }
  .orb { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; }
  .orb-1 { width: 540px; height: 540px; background: radial-gradient(circle, rgba(233,169,59,0.30), transparent 65%); top: -190px; inset-inline-start: -140px; }
  .orb-2 { width: 480px; height: 480px; background: radial-gradient(circle, rgba(139,92,246,0.22), transparent 65%); top: -120px; inset-inline-end: -120px; }
  .orb-3 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(56,200,242,0.13), transparent 65%); bottom: -220px; left: 50%; transform: translateX(-50%); }
  header > * { position: relative; z-index: 1; }

  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px; margin: 0 0 22px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold); background: var(--gold-soft); border: 1px solid var(--gold-border);
    padding: 8px 18px; border-radius: 50px;
  }
  .hero-tag .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); animation: blink 2s infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }

  h1.wordmark {
    margin: 0; font-family: 'Sora', 'Poppins', sans-serif;
    font-size: clamp(2.9rem, 8.5vw, 5.4rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.02;
  }
  h1.wordmark .tv { display: inline-block; transform: translateY(-0.06em); }
  .hero-sub {
    max-width: 620px; margin: 20px auto 0; color: var(--muted);
    font-size: 1.05rem; font-weight: 500;
  }
  .hero-sub strong { color: var(--ink); font-weight: 700; }

  .hero-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 15px 30px; border-radius: var(--radius-pill);
    font-weight: 700; font-size: 0.95rem; text-decoration: none;
    border: 1px solid transparent; cursor: pointer; font-family: inherit;
    transition: transform .2s, box-shadow .2s, filter .2s, background .2s;
  }
  .btn:active { transform: scale(0.97); }
  .btn-wa { background: var(--wa); color: #04340f; box-shadow: 0 14px 34px rgba(37,211,102,0.32); animation: pulse-green 2.4s infinite; }
  .btn-wa:hover { filter: brightness(1.06); transform: translateY(-2px); }
  @keyframes pulse-green {
    0% { box-shadow: 0 14px 34px rgba(37,211,102,0.32), 0 0 0 0 rgba(37,211,102,0.40); }
    70% { box-shadow: 0 14px 34px rgba(37,211,102,0.32), 0 0 0 14px rgba(37,211,102,0); }
    100% { box-shadow: 0 14px 34px rgba(37,211,102,0.32), 0 0 0 0 rgba(37,211,102,0); }
  }
  .btn-ghost { background: rgba(255,255,255,0.04); border-color: var(--line-strong); color: var(--ink); }
  .btn-ghost:hover { background: rgba(255,255,255,0.08); transform: translateY(-2px); }

  .hero-stats {
    display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
    margin-top: 46px;
  }
  .stat {
    min-width: 150px; padding: 16px 22px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 18px; backdrop-filter: blur(8px);
  }
  .stat-num { display: block; font-family: 'Sora', 'Poppins', sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--gold); letter-spacing: -0.02em; }
  .stat-label { font-size: 0.76rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 1.2px; }

  .hero-chips { display: flex; justify-content: center; gap: 9px; flex-wrap: wrap; margin-top: 26px; }
  .chip {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 0.8rem; font-weight: 600; color: #c9cdd8;
    background: rgba(255,255,255,0.04); border: 1px solid var(--line);
    padding: 8px 16px; border-radius: 50px;
  }
  .chip i { color: var(--gold); font-size: 1rem; }

  /* marquee */
  .marquee {
    overflow: hidden; direction: ltr;
    border-block: 1px solid var(--line);
    background: rgba(255,255,255,0.02);
    padding: 15px 0; position: relative; z-index: 1;
  }
  .marquee-inner { display: flex; gap: 44px; width: max-content; animation: mq 36s linear infinite; }
  .marquee:hover .marquee-inner { animation-play-state: paused; }
  .marquee-item { white-space: nowrap; color: #a7adbb; font-weight: 600; font-size: 0.88rem; display: flex; align-items: center; gap: 12px; }
  .marquee-item i { color: var(--gold); font-size: 0.7rem; }
  @keyframes mq { to { transform: translateX(-50%); } }

  /* ================= SECTIONS ================= */
  .band { position: relative; overflow: hidden; padding: 78px 0 88px; }
  .band + .band { border-top: 1px solid var(--line); }
  .section-head { text-align: center; margin-bottom: 40px; }
  .kicker {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
    color: var(--gold); background: var(--gold-soft); border: 1px solid var(--gold-border);
    padding: 7px 16px; border-radius: 50px;
  }
  .section-head h2 { margin: 0; font-family: 'Sora', 'Poppins', sans-serif; font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; }
  .section-head p { margin: 12px 0 0; color: var(--muted); font-size: 0.97rem; }

  /* ================= PLAN CARDS ================= */
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .selection-card {
    --tint: var(--gold); --tint-soft: var(--gold-soft);
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.02));
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 26px 20px 22px; text-align: center; cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s cubic-bezier(0.175,0.885,0.32,1.275), border-color 0.3s, box-shadow 0.3s;
    display: flex; flex-direction: column; align-items: center;
  }
  .selection-card::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 140px;
    background: radial-gradient(240px 120px at 50% -30px, var(--tint-soft), transparent 70%);
    pointer-events: none;
  }
  .selection-card:hover { transform: translateY(-7px); border-color: var(--tint); box-shadow: 0 20px 50px rgba(0,0,0,0.45), 0 0 0 1px var(--tint); }
  .selection-card:active { transform: scale(0.98); }
  .selection-card.picked { border-color: var(--tint); box-shadow: 0 0 0 2px var(--tint-soft), var(--shadow); }
  .selection-card.picked::after {
    content: "\2713"; position: absolute; top: 14px; inset-inline-start: 14px;
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--tint); color: #0a0a10;
    font-weight: 800; font-size: 0.8rem; display: flex; align-items: center; justify-content: center;
    z-index: 2;
  }

  .badge-container { position: absolute; top: 14px; inset-inline-end: 14px; display: flex; flex-direction: column; align-items: flex-end; gap: 5px; z-index: 2; }
  body.rtl .badge-container { align-items: flex-start; }
  .badge { font-size: 0.62rem; font-weight: 800; padding: 4px 10px; border-radius: 9px; text-transform: uppercase; letter-spacing: 0.5px; }
  .badge.gold { background: var(--gold-grad); color: #231703; }
  .badge.red { background: var(--red); color: #2a050c; }
  .badge.soft { background: transparent; color: var(--tint); border: 1px solid var(--tint); }

  .card-img { width: 92px; height: 92px; object-fit: contain; margin-bottom: 14px; filter: drop-shadow(0 10px 22px rgba(0,0,0,0.5)); }
  .card-text { font-weight: 800; font-size: 1.12rem; line-height: 1.3; color: var(--ink); font-family: 'Sora','Poppins',sans-serif; }
  .price-text { margin: 8px 0 16px; }
  .price-text .amount { font-family: 'Sora','Poppins',sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--tint); letter-spacing: -0.02em; }
  .price-text .per { display: block; font-size: 0.75rem; color: var(--muted); font-weight: 600; }

  .feature-list {
    text-align: start; width: 100%; margin-top: 2px; margin-bottom: 18px;
    padding: 14px 15px; background: rgba(255,255,255,0.03);
    border: 1px solid var(--line); border-radius: 15px;
    font-size: 0.83rem; color: #b9becb;
  }
  .feature-list div { margin-bottom: 9px; display: flex; align-items: flex-start; gap: 9px; line-height: 1.4; }
  .feature-list div:last-child { margin-bottom: 0; }
  .feature-list i { font-size: 1.05rem; color: var(--tint); flex-shrink: 0; margin-top: 1px; }
  .feature-list strong { color: var(--ink); }

  .card-cta {
    margin-top: auto; width: 100%;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 13px; border-radius: 14px;
    background: var(--tint-soft); color: var(--tint);
    border: 1px solid var(--tint);
    font-family: inherit; font-weight: 700; font-size: 0.88rem; cursor: pointer;
    transition: all .2s;
  }
  .card-cta:hover { background: var(--tint); color: #0a0a10; }

  /* ================= SETUP FLOW ================= */
  #sx {
    --card: rgba(255,255,255,0.045);
    --border: var(--line);
    --border-strong: var(--line-strong);
    --text: var(--ink);
    --accent: #e9b949; --accent-700: #f7dc8a;
    --accent-soft: rgba(233,185,73,0.12); --accent-soft-2: rgba(233,185,73,0.32);
    --warn: #f2b23e; --warn-bg: rgba(242,178,62,0.08); --warn-border: rgba(242,178,62,0.34);
    --radius: 18px; --radius-sm: 13px;
    --font: 'Poppins', sans-serif;
    text-align: start;
  }
  body.rtl #sx { --font: 'Cairo', sans-serif; }

  #sx .golden {
    margin: 0 0 34px; display: flex; align-items: center; gap: 15px;
    background: linear-gradient(135deg, rgba(233,185,73,0.14), rgba(255,120,71,0.06));
    border: 1px solid var(--gold-border); border-radius: 16px; padding: 16px 20px;
  }
  #sx .golden svg.gr-key { width: 26px; height: 26px; color: var(--gold); flex-shrink: 0; }
  #sx .golden .gr-title { margin: 0; font-size: 15px; line-height: 1.5; color: #f0dcae; }
  #sx .golden .gr-title b { font-weight: 800; color: #ffe9b8; }
  #sx .golden .gr-sub { margin: 3px 0 0; font-size: 12.5px; line-height: 1.45; color: #c9b078; }

  #sx .block { margin-top: 40px; scroll-margin-top: 24px; }
  #sx .block:first-of-type { margin-top: 10px; }
  #sx .block[hidden] { display: none; }
  #sx .block-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  #sx .block-label { display: flex; align-items: center; gap: 11px; margin: 0 0 20px; font-size: 13px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font); }
  #sx .block-head .block-label { margin: 0; }
  #sx .block-label .num {
    width: 24px; height: 24px; border-radius: 8px; display: grid; place-items: center;
    background: var(--accent-soft); color: var(--accent); font-size: 12.5px; font-weight: 800;
    box-shadow: inset 0 0 0 1px var(--accent-soft-2);
  }

  #sx .reset {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    background: var(--card); border: 1.5px solid var(--border-strong); color: var(--text);
    font-family: var(--font); font-weight: 600; font-size: 13px; padding: 8px 16px; border-radius: 999px;
    transition: all .18s;
  }
  #sx .reset[hidden] { display: none; }
  #sx .reset .ric { display: grid; place-items: center; width: 15px; height: 15px; }
  #sx .reset .ric svg { width: 100%; height: 100%; }
  #sx .reset:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  #sx .plans-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  #sx .plan-card {
    cursor: pointer; text-align: center;
    background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 20px 12px 16px; font-family: var(--font); color: var(--text);
    display: flex; flex-direction: column; align-items: center; gap: 11px;
    transition: all .2s; position: relative;
  }
  #sx .plan-card:hover { border-color: var(--p-accent); transform: translateY(-3px); box-shadow: var(--shadow-sm); }
  #sx .plan-card.is-active { border-color: var(--p-accent); background: var(--p-soft); box-shadow: 0 0 0 3px var(--p-soft), var(--shadow-sm); }
  #sx .plan-card-img { width: 66px; height: 66px; object-fit: contain; display: block; border-radius: 22%; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5)); transition: transform .2s; }
  #sx .plan-card:hover .plan-card-img { transform: scale(1.05); }
  #sx .plan-card-name { font-weight: 700; font-size: 13.5px; letter-spacing: -0.01em; line-height: 1.25; }
  #sx .plan-check {
    position: absolute; top: 10px; inset-inline-end: 10px;
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--p-accent); color: #0a0a10; display: none; place-items: center;
  }
  #sx .plan-card.is-active .plan-check { display: grid; }
  #sx .plan-check svg { width: 12px; height: 12px; }

  #sx .devices { display: flex; flex-wrap: wrap; gap: 12px; }
  #sx .device {
    flex: 0 1 138px; cursor: pointer; text-align: center;
    background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius-sm);
    padding: 17px 12px 14px; font-family: var(--font); color: var(--text);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    transition: all .18s;
  }
  #sx .device:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: var(--shadow-sm); }
  #sx .device.is-active { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 3px var(--accent-soft); }
  #sx .device-icon { width: 30px; height: 30px; color: var(--accent); display: grid; place-items: center; }
  #sx .device-icon svg { width: 100%; height: 100%; }
  #sx .device-name { font-size: 12.5px; font-weight: 600; line-height: 1.3; color: #c9cdd8; }
  #sx .device.is-active .device-name { color: var(--ink); }

  #sx .crumb { font-size: 14px; color: var(--muted); margin: 0 0 24px; }
  #sx .crumb:empty { display: none; }
  #sx .crumb b { color: var(--text); font-weight: 700; }
  #sx .steps { list-style: none; margin: 0 0 6px; padding: 0; position: relative; }
  #sx .steps:empty { display: none; }
  #sx .steps::before { content: ""; position: absolute; inset-inline-start: 16px; top: 10px; bottom: 26px; width: 2px; background: var(--border); }
  #sx .step { position: relative; display: flex; gap: 17px; align-items: flex-start; padding-bottom: 24px; }
  #sx .step:last-child { padding-bottom: 8px; }
  #sx .step-num {
    flex: 0 0 33px; width: 33px; height: 33px; border-radius: 50%; position: relative; z-index: 1;
    background: #101018; border: 1.5px solid var(--accent); color: var(--accent);
    display: grid; place-items: center; font-weight: 800; font-size: 13.5px;
  }
  #sx .step-body { padding-top: 4px; min-width: 0; flex: 1; }
  #sx .step-text { margin: 0; font-size: 15px; line-height: 1.65; color: var(--text); }
  #sx .step-text b { font-weight: 700; }
  #sx .step-text .hint { display: block; margin-top: 7px; font-size: 13px; color: var(--muted); }
  #sx .step-text a, #sx .note a { color: var(--accent); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--accent-soft-2); }
